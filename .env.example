# ---- Root example env for `docker compose up`. Copy to `.env`. ----
# Local Postgres (compose) credentials — dev-only values are fine here.
POSTGRES_USER="tesla"
POSTGRES_PASSWORD="tesla-pool-dev-only"
POSTGRES_DB="teslapool"

# API signing secret — generate a fresh one for any shared/staging deploy:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"

# Seed the Jashim/Nusrat/Rafiq demo cast on `docker compose up`.
SEED_DEMO="true"

# URL the BROWSER uses to reach the API (baked into the web image at build time).
PUBLIC_API_URL="http://localhost:4000"
